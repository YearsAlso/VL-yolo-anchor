{
  "$schema": "https://schema.tauri.app/config/1",
  "package": {
    "productName": "VL-YOLO-Anchor",
    "version": "0.1.0"
  },
  "build": {
    "devPath": "http://localhost:5173",
    "distDir": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "tauri": {
    "allowlist": {
      "http": {
        "all": false,
        "request": true,
        "scope": ["http://127.0.0.1:8765/*"]
      }
    },
    "windows": [
      {
        "title": "VL-YOLO-Anchor",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ],
    "bundle": {
      "active": true,
      "identifier": "com.vlyoloanchor.app",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.ico",
        "icons/icon.png"
      ]
    },
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8765; img-src 'self' blob: data: http://127.0.0.1:8765; style-src 'self' 'unsafe-inline'"
    }
  }
}
