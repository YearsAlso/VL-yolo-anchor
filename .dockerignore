# Version control / CI
.git
.github
.gitignore

# Python
.venv
__pycache__
*.pyc
.pytest_cache
.mypy_cache
.ruff_cache
src/vl_yolo_anchor.egg-info

# Generated task/log artifacts (must come from the /data volume, not the image)
tasks
logs

# GUI has its own image / build context
gui/node_modules
gui/dist
gui/src-tauri
node_modules

# Local env / secrets
.env
*.local
# Host-side encrypted store + local config overrides: these are machine state,
# not source. Baking config/secrets.db into the image would ship the operator's
# ciphertext (and it would be unreadable anyway without the master key).
config/secrets.db
config/secrets.db-journal
config/overrides.yaml
secrets

# Editor/OS noise
.DS_Store
.idea
.vscode
