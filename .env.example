# Copy to .env and adjust. docker-compose reads this via env_file.
# Anything set here overrides config/global.yaml but is itself overridden by
# real environment variables (see src/config.py precedence).

# ---- Backend server ----
# Bind inside the container (compose fixes this to 0.0.0.0).
VL_ANCHOR_HOST=0.0.0.0
VL_ANCHOR_PORT=8765
# Writable root for tasks/ and logs/ (mounts onto the vl-data volume).
VL_ANCHOR_DATA_DIR=/data

# ---- CORS ----
# Only needed if a browser hits the backend directly from another origin.
# When using the gui's nginx /api proxy this can stay empty/loopback.
VL_ANCHOR_CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# ---- Optional API auth ----
# When set, every /api/* call must send "Authorization: Bearer <token>"
# (except /api/health). If you enable this, also add the header in nginx or
# call the backend directly. Leave empty to disable (recommended for the
# loopback/dev default).
# The token may also come from VL_ANCHOR_AUTH_TOKEN_FILE, or from the encrypted
# store:  uv run python run.py secret-set VL_ANCHOR_AUTH_TOKEN
VL_ANCHOR_AUTH_TOKEN=

# GUI side of the same token. The SPA sends whatever it finds in localStorage
# key "vl_auth_token" (paste it once in the settings tab), or this build-time
# value if it is non-empty. Used by gui/Dockerfile as a docker build arg.
VITE_AUTH_TOKEN=

# ---- Storage and the metadata index ----
# Audit logs (tasks/<task>/run_history.jsonl, model_calls.jsonl, logs/*.jsonl)
# are the source of truth. The SQLite index is a rebuildable projection: delete
# the file at any time and run "uv run python run.py index --rebuild" — no data
# is lost, the platform just re-derives it. Set VL_ANCHOR_DB_ENABLED=0 to skip
# SQLite entirely.
VL_ANCHOR_DB_PATH=/data/index.db
VL_ANCHOR_DB_ENABLED=1

# ---- Secret encryption master key ----
# API keys saved from the GUI settings page are symmetrically encrypted
# (Fernet: AES-128-CBC + HMAC) into config/secrets.db, a file separate from the
# index. The ciphertext is useless without the master key, which is read ONLY
# from VL_ANCHOR_SECRET_KEY / VL_ANCHOR_SECRET_KEY_FILE — never from YAML, never
# from the command line.
#
# Generate one:  uv run python run.py secret-keygen
#
# Three constraints worth reading before you configure anything:
# 1. Do NOT put the master key in this .env file. .env lives next to the app and
#    leaks far more easily than a mounted secret; use the *_FILE form with a
#    Docker/K8s secret (docker-compose.yml has a working example).
# 2. No master key is NOT a broken deployment: the platform starts, the settings
#    page reports the store as unavailable, and API keys can only come from
#    VL_LLM_API_KEY / VL_VL_API_KEY (including their *_FILE variants). If the key
#    is lost, existing ciphertext cannot be recovered by design — re-enter the
#    keys.
# 3. api_key written under "model:" in config/global.yaml is ignored. A
#    plaintext key in a YAML file is exactly what this store exists to avoid.
VL_ANCHOR_SECRET_KEY_FILE=/run/secrets/vl_master_key
# VL_ANCHOR_SECRET_KEY=          # dev only — prefer the *_FILE form above

# ---- LLM / VL model backends ----
# Two roles, wired to different agents:
#   llm -> PlanAgent (text), vl -> AnnotateAgent (vision).
# Set the shared defaults with VL_MODEL_*; override per role with VL_LLM_* /
# VL_VL_* (leave a role's vars empty to inherit the shared value).
# provider: stub (offline, no network) | remote (OpenAI-compatible endpoint).
# Prefer entering API keys in the GUI settings page (they go to the encrypted
# store, see below) or via "run.py secret-set"; a key in this file is plaintext
# on disk. Either way, do not commit a filled-in .env.
VL_MODEL_PROVIDER=stub
VL_MODEL_BASE_URL=
VL_MODEL_API_KEY=
VL_MODEL_NAME=

# Plan step (text LLM) — only set what differs from the shared values above.
# VL_LLM_PROVIDER=remote
# VL_LLM_BASE_URL=https://api.example.com/v1
# VL_LLM_API_KEY=
# VL_LLM_NAME=gpt-4o-mini

# Annotate step (vision-language) — only set what differs.
# VL_VL_PROVIDER=remote
# VL_VL_BASE_URL=http://host.docker.internal:11434/v1
# VL_VL_API_KEY=
# VL_VL_NAME=qwen2.5vl:7b

# ---- Image tag used by docker-compose ----
VERSION=0.1.0
