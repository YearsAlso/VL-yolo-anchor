# Copy to .env and adjust. docker-compose reads this via env_file.
# Anything set here overrides config/global.yaml but is itself overridden by
# real environment variables (see src/config.py precedence).

# ---- Backend server ----
# Bind inside the container (compose fixes this to 0.0.0.0).
VL_ANCHOR_HOST=0.0.0.0
VL_ANCHOR_PORT=8765
# Writable root for tasks/ and logs/ (mounts onto the vl-data volume).
VL_ANCHOR_DATA_DIR=/data

# ---- CORS ----
# Only needed if a browser hits the backend directly from another origin.
# When using the gui's nginx /api proxy this can stay empty/loopback.
VL_ANCHOR_CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# ---- Optional API auth ----
# When set, every /api/* call must send "Authorization: Bearer <token>"
# (except /api/health). If you enable this, also add the header in nginx or
# call the backend directly. Leave empty to disable (recommended for the
# loopback/dev default).
VL_ANCHOR_AUTH_TOKEN=

# ---- LLM / VL model backends ----
# Two roles, wired to different agents:
#   llm -> PlanAgent (text), vl -> AnnotateAgent (vision).
# Set the shared defaults with VL_MODEL_*; override per role with VL_LLM_* /
# VL_VL_* (leave a role's vars empty to inherit the shared value).
# provider: stub (offline, no network) | remote (OpenAI-compatible endpoint).
VL_MODEL_PROVIDER=stub
VL_MODEL_BASE_URL=
VL_MODEL_API_KEY=
VL_MODEL_NAME=

# Plan step (text LLM) — only set what differs from the shared values above.
# VL_LLM_PROVIDER=remote
# VL_LLM_BASE_URL=https://api.example.com/v1
# VL_LLM_API_KEY=
# VL_LLM_NAME=gpt-4o-mini

# Annotate step (vision-language) — only set what differs.
# VL_VL_PROVIDER=remote
# VL_VL_BASE_URL=http://host.docker.internal:11434/v1
# VL_VL_API_KEY=
# VL_VL_NAME=qwen2.5vl:7b

# ---- Image tag used by docker-compose ----
VERSION=0.1.0
